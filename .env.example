# ==============================================================
# CESTAON — CONFIGURAÇÕES DE PRODUÇÃO E DEPLOY NA NUVEM
# ==============================================================

# Porta do servidor HTTP & WebSockets (definida automaticamente por Render, Koyeb, Fly.io)
PORT=3000

# Ambiente de execução: development ou production
# Em produção (production): ativa cabeçalho HSTS rigoroso, desativa stack traces expostos e liga cache estático PWA
NODE_ENV=production

# --------------------------------------------------------------
# SEGURANÇA E SESSÕES CRIPTOGRÁFICAS (AUTENTICAÇÃO HMAC-SHA256)
# --------------------------------------------------------------
# Chave secreta de alta entropia para assinatura e validação de tokens de sessão (JWT compacto).
# Mandatório em produção (mínimo de 32 caracteres aleatórios). Em produção, se não informada,
# o servidor gera automaticamente uma chave efêmera de 256 bits em memória, bloqueando forjas externas.
# Gere com: openssl rand -hex 32  ou  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# --------------------------------------------------------------
# BANCO DE DADOS EM NUVEM (100% CUSTO ZERO PERPÉTUO — TURSO LIBSQL)
# --------------------------------------------------------------
# Para hospedagens gratuitas com disco efêmero (Render Free, Koyeb Free),
# utilize o Turso (SQLite em nuvem gratuito para sempre, sem expiração e sem cartão de crédito).
# Obtenha em https://turso.tech (Free Tier perpétuo com 9GB de dados):
LIBSQL_URL=
LIBSQL_AUTH_TOKEN=

# Caminho de persistência do banco de dados SQLite local (usado quando LIBSQL_URL não for informada)
DB_PATH=./data/feira.db

# Domínios autorizados pela política CORS e WebSocket (mitigação mandatória de CSWSH).
# ATENÇÃO: NUNCA utilize '*' em produção com dados de usuários reais.
# Configure com a URL pública HTTPS do seu frontend/serviço no Render:
# Exemplo: https://seu-app.onrender.com,https://cestaon.com.br
CORS_ORIGIN=https://seu-app.onrender.com

# Habilita suporte a proxies reversos (Cloudflare, Nginx, Traefik, Render)
# Garante que os limitadores de taxa (Rate Limiting) capturem o IP real do cliente (via X-Forwarded-For) em vez do IP da nuvem
TRUST_PROXY=true

# --------------------------------------------------------------
# SERVIÇOS DE E-MAIL TRANSACIONAL (100% CUSTO ZERO PERPÉTUO)
# --------------------------------------------------------------
# Opção Recomendada no Render Free (Porta 443 HTTPS - Sem Bloqueio de Firewall):
# Crie sua chave gratuita (300 envios/dia) em: brevo.com -> SMTP & API -> API Keys
BREVO_API_KEY=

# Alternativa via Webhook Google Apps Script (Porta 443 HTTPS):
GMAIL_WEBHOOK_URL=

# Fallback para desenvolvimento local via SMTP:
EMAIL_USER=
EMAIL_PASS=
