{
  "name": "feira-inteligente",
  "version": "1.0.0",
  "description": "Lista de Compras Inteligente - Planejamento, Orçamento, Histórico e Comparativo de Feiras",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node server/index.js",
    "server": "node server/index.js",
    "test": "node --import \"data:text/javascript,process.env.NODE_ENV='test';\" --test --test-concurrency=1 tests/**/*.test.js",
    "postinstall": "npm --prefix client install --include=dev",
    "client": "npm --prefix client run dev",
    "build:client": "npm --prefix client run build",
    "build": "npm install && npm --prefix client install --include=dev && npm --prefix client run build",
    "dev": "node server/index.js"
  },
  "dependencies": {
    "@libsql/client": "^0.18.0",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "nodemailer": "^10.5.0",
    "ws": "^8.18.0"
  }
}
